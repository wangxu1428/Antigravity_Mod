    "width": 450,
    "collapsed": true,
    "activeTab": "gemini"
  },
  "i18n": {
    "enabled": true,
    "language": "zh-CN",
    "preset": "full",
    "scope": {
      "menu": true,
      "settings": true,
      "agent": true,
      "models": true,
      "requests": true,
      "errors": true,
